#!/usr/bin/env bash
# ABOUTME: Keeps learners' sandbox containers from reaching each other or the host; only the gateway is allowed.
# Managed by Ansible. Runs after Docker starts; safe to rerun.
set -euo pipefail

bridge="{{ sandbox_bridge }}"
gateway="{{ gateway_ip }}"
chain="SANDBOX-ISOLATION"

# Docker creates DOCKER-USER when it starts; wait for it rather than racing.
for _ in $(seq 1 30); do
    if iptables -L DOCKER-USER -n >/dev/null 2>&1; then
        break
    fi
    sleep 1
done

# Rebuild our own chain from scratch so reruns converge on the same rules.
iptables -N "${chain}" 2>/dev/null || iptables -F "${chain}"
iptables -A "${chain}" -d "${gateway}" -j RETURN
iptables -A "${chain}" -s "${gateway}" -j RETURN
iptables -A "${chain}" -j DROP

# Traffic between two members of the sandbox bridge passes through FORWARD (br_netfilter), so DOCKER-USER sees it.
iptables -C DOCKER-USER -i "${bridge}" -o "${bridge}" -j "${chain}" 2>/dev/null \
    || iptables -I DOCKER-USER 1 -i "${bridge}" -o "${bridge}" -j "${chain}"

# The host runs nothing sandboxes may call (Codapi and the Docker API answer on every interface).
iptables -C INPUT -i "${bridge}" -j DROP 2>/dev/null \
    || iptables -I INPUT 1 -i "${bridge}" -j DROP
