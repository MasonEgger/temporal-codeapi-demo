{
    "run": {
        "engine": "docker",
        "entry": "client.py",
        "steps": [
            {
                "box": "temporal-python",
                "detach": true,
                "command": [
                    "temporal-serve"
                ]
            },
            {
                "box": ":name",
                "action": "exec",
                "command": [
                    "temporal-run",
                    "--pass-name",
                    "--worker",
                    "exec python /opt/temporal/run_program.py worker.py",
                    "--",
                    "python",
                    "/opt/temporal/run_program.py",
                    "client.py"
                ],
                "timeout": 120,
                "noutput": 65536
            }
        ]
    },
    "history": {
        "engine": "docker",
        "entry": "client.py",
        "steps": [
            {
                "box": "temporal-python",
                "detach": true,
                "command": [
                    "temporal-serve"
                ]
            },
            {
                "box": ":name",
                "action": "exec",
                "command": [
                    "temporal-run",
                    "--pass-name",
                    "--history",
                    "--worker",
                    "exec python /opt/temporal/run_program.py worker.py",
                    "--",
                    "python",
                    "/opt/temporal/run_program.py",
                    "client.py"
                ],
                "timeout": 120,
                "noutput": 65536
            }
        ]
    },
    "test": {
        "engine": "docker",
        "entry": "tests/test_workflows.py",
        "steps": [
            {
                "box": "temporal-python",
                "command": [
                    "temporal-run",
                    "--no-server",
                    "--",
                    "python",
                    "/opt/temporal/run_program.py",
                    "-m",
                    "pytest",
                    "-v",
                    "-p",
                    "no:cacheprovider",
                    "tests"
                ],
                "timeout": 90,
                "noutput": 65536
            }
        ]
    }
}
