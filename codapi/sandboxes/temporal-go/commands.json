{
    "run": {
        "engine": "docker",
        "entry": "main.go",
        "steps": [
            {
                "box": "temporal-go",
                "command": ["temporal-run", "go", "run", "."],
                "timeout": 30,
                "noutput": 65536
            }
        ]
    },
    "history": {
        "engine": "docker",
        "entry": "main.go",
        "steps": [
            {
                "box": "temporal-go",
                "command": ["temporal-run", "--history", "go", "run", "."],
                "timeout": 30,
                "noutput": 65536
            }
        ]
    }
}
