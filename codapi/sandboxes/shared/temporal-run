#!/usr/bin/env bash
# ABOUTME: Codapi entrypoint shared by every Temporal sandbox image.
# ABOUTME: Starts a throwaway dev server, runs the learner's program, then optionally prints event histories.
#
# Usage: temporal-run [--history] <command> [args...]
#
# Codapi mounts the learner's files read-only at /sandbox. This script copies them
# into the image's prepared project directory ($TEMPORAL_APP_DIR), where the SDK
# dependencies already live, and runs the language command from there.
set -euo pipefail

show_history=false
if [[ "${1:-}" == "--history" ]]; then
    show_history=true
    shift
fi

# Start an in-memory, headless dev server that lives only as long as this container.
temporal server start-dev \
    --headless \
    --ip 127.0.0.1 \
    --log-level error \
    >/tmp/temporal-server.log 2>&1 &

# Wait up to 10 seconds for the frontend service to answer health checks.
for _ in $(seq 1 100); do
    if temporal operator cluster health >/dev/null 2>&1; then
        break
    fi
    sleep 0.1
done
if ! temporal operator cluster health >/dev/null 2>&1; then
    echo "Temporal dev server failed to start:" >&2
    cat /tmp/temporal-server.log >&2
    exit 1
fi

# Copy the learner's files next to the prepared dependencies and run the program.
cp -r /sandbox/. "${TEMPORAL_APP_DIR}/"
cd "${TEMPORAL_APP_DIR}"
exit_code=0
"$@" || exit_code=$?

# Print the event history of every Workflow the program started.
if [[ "${show_history}" == true ]]; then
    for workflow_id in $(temporal workflow list --output json | jq -r '.[].execution.workflowId'); do
        echo
        echo "=== Event History: ${workflow_id} ==="
        temporal workflow show --workflow-id "${workflow_id}"
    done
fi

exit "${exit_code}"
